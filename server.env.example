# 后端 API 服务端环境变量示例（部署到服务器时使用，复制为 .env）
# 注意：这是 server.js 用的环境变量，与前端的 .env（VITE_*）不同。

# 服务端口与监听
PORT=3000

# SQLite 数据库文件路径
DB_PATH=/var/lib/gamexxxyx-api/app.db

# 允许的前端来源，多个用逗号分隔；留空表示不限制
CORS_ORIGIN=https://bluewangxiaozhe.github.io

# 后台管理令牌（= 后台登录密码）。所有写接口都需要它，必填！
# 请用足够强的随机字符串。
ADMIN_TOKEN=请改成你的强密码

# Cloudflare R2 存储配置
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2 公网访问域名（数据库里实际存储的域名，海外线路）
R2_PUBLIC_URL=https://oss.wangzhe.me
